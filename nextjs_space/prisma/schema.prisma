generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/safedrive_ai_monitor/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("reviewer")
  accounts      Account[]
  sessions      Session[]
  reviewActions ReviewAction[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Driver {
  id              String          @id @default(cuid())
  name            String
  vehicleId       String
  vehicleType     String
  status          String          @default("active")
  totalEvents     Int             @default(0)
  totalWarnings   Int             @default(0)
  riskLevel       String          @default("low")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sensorEvents    SensorEvent[]
  telematicsEvents TelematicsEvent[]
  riskScores      RiskScore[]
  warnings        Warning[]
  reviewActions   ReviewAction[]

  @@index([status])
  @@index([riskLevel])
}

model SensorEvent {
  id              String    @id @default(cuid())
  driverId        String
  driver          Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  eventType       String    // phone_handling, screen_on, texting, gaze_off_road, hands_off_wheel
  confidence      Float
  duration        Float?    // seconds
  metadata        String?   // JSON string for extra data
  isGroundTruth   Boolean   @default(false)
  groundTruthLabel String?  // true_positive, false_positive, true_negative, false_negative
  timestamp       DateTime  @default(now())

  @@index([driverId])
  @@index([eventType])
  @@index([timestamp])
  @@index([isGroundTruth])
}

model TelematicsEvent {
  id              String    @id @default(cuid())
  driverId        String
  driver          Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  speed           Float?    // mph
  laneDrift       Float?    // deviation in meters
  brakingForce    Float?    // 0-1 scale
  isMoving        Boolean
  passengerPresent Boolean  @default(false)
  latitude        Float?
  longitude       Float?
  metadata        String?   // JSON string
  timestamp       DateTime  @default(now())

  @@index([driverId])
  @@index([timestamp])
}

model RiskScore {
  id              String    @id @default(cuid())
  driverId        String
  driver          Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  score           Float     // 0-100
  confidence      Float     // 0-1
  factors         String    // JSON: array of contributing factors
  missingData     String?   // JSON: list of missing signals
  rationale       String?   // LLM-generated explanation
  threshold       Float     @default(60)
  exceededThreshold Boolean @default(false)
  processingTimeMs Int?     // latency tracking
  timestamp       DateTime  @default(now())
  warnings        Warning[]

  @@index([driverId])
  @@index([timestamp])
  @@index([exceededThreshold])
}

model WarningTemplate {
  id              String    @id @default(cuid())
  category        String    // gentle_reminder, firm_warning, escalation_notice
  text            String
  severity        Int       // 1-3
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  warnings        Warning[]

  @@index([category])
}

model Warning {
  id              String          @id @default(cuid())
  driverId        String
  driver          Driver          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  riskScoreId     String
  riskScore       RiskScore       @relation(fields: [riskScoreId], references: [id])
  templateId      String?
  template        WarningTemplate? @relation(fields: [templateId], references: [id])
  warningText     String
  severity        Int             @default(1)
  activityStoppedAfter Boolean?   // null = unknown, true = stopped, false = continued
  responseTimeMs  Int?            // ms until activity stopped
  status          String          @default("delivered") // delivered, acknowledged, ignored
  createdAt       DateTime        @default(now())
  reviewActions   ReviewAction[]

  @@index([driverId])
  @@index([riskScoreId])
  @@index([templateId])
  @@index([status])
  @@index([createdAt])
}

model ReviewAction {
  id              String    @id @default(cuid())
  driverId        String
  driver          Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  warningId       String?
  warning         Warning?  @relation(fields: [warningId], references: [id])
  reviewerId      String?
  reviewer        User?     @relation(fields: [reviewerId], references: [id])
  action          String    // pending, approved, dismissed, escalated
  notes           String?
  escalationReason String?
  confidence      Float?
  eventSummary    String?   // JSON summary of event chain
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([driverId])
  @@index([warningId])
  @@index([reviewerId])
  @@index([action])
  @@index([createdAt])
}

model AnalyticsSnapshot {
  id              String    @id @default(cuid())
  period          String    // YYYY-MM-DD
  precision       Float
  recall          Float
  falseWarningRate Float
  escalationVolume Int
  meanLatencyMs   Float
  driverResponseRate Float
  totalEvents     Int
  totalWarnings   Int
  repeatedDistractions Int
  createdAt       DateTime  @default(now())

  @@unique([period])
  @@index([period])
}
